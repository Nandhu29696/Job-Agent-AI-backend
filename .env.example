# ─── App ──────────────────────────────────────────────────────
APP_ENV=development                 # production disables /docs and enforces a strong SECRET_KEY
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
SUPER_ADMIN_EMAIL=                  # promoted to super_admin on startup if none exists

# ─── Database ─────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=job_agent
DB_USER=postgres
DB_PASSWORD=change-me
DB_TYPE=postgresql                  # postgresql | mysql

# ─── Ollama (local LLM) ───────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT_SECONDS=120

# ─── Security ─────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ALGORITHM=HS256
JWT_ACCESS_MINUTES=15               # short-lived access token (memory only)
JWT_REFRESH_MINUTES=10080           # refresh token in httpOnly cookie
COOKIE_SECURE=false                 # true when served over HTTPS
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# ─── Google Sign-in (OAuth2) ──────────────────────────────────
# Google Cloud Console → Credentials → OAuth client (Web).
# Authorised redirect URI must equal GMAIL_REDIRECT_URI exactly.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/integrations/gmail/callback

# ─── Email (SMTP) for OTPs ────────────────────────────────────
# Gmail: use an App Password (Google Account → Security → App passwords)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# ─── OTP ──────────────────────────────────────────────────────
OTP_EXPIRY_SECONDS=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ─── Razorpay ─────────────────────────────────────────────────
# Dashboard → Settings → API Keys (use rzp_test_… keys while testing)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks → URL: https://<api-host>/api/payments/webhook
# Events: payment.captured, order.paid
RAZORPAY_WEBHOOK_SECRET=
CURRENCY=INR

# ─── Monetisation defaults (editable live by super admin) ─────
PRO_PLAN_PRICE_PAISE=29900
PRO_PLAN_DAYS=30
FREE_DAILY_AI_LIMIT=15
